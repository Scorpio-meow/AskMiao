FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt /tmp/requirements.txt
COPY deploy/filter_requirements.py /tmp/filter_requirements.py

RUN TORCH_VERSION="$(grep -m1 -oP '^torch==\K[0-9.]+' /tmp/requirements.txt)" \
    && pip install "torch==${TORCH_VERSION}" --index-url https://download.pytorch.org/whl/cpu \
    && python /tmp/filter_requirements.py /tmp/requirements.txt /tmp/requirements.cpu.txt \
    && pip install -r /tmp/requirements.cpu.txt

COPY backend/ /app/

RUN useradd --uid 1000 --create-home askmiao \
    && mkdir -p /app/data /app/keys /app/logs /app/mcp_filesystem_sandbox \
    && chown -R askmiao:askmiao /app/data /app/keys /app/logs /app/mcp_filesystem_sandbox

USER askmiao

CMD ["python", "main.py"]
