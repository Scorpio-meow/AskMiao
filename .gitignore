
# .gitignore for AI-CB project
# Generated to ignore common Python/Node artifacts, virtualenvs, OS files, IDE files,
# large data/index files (faiss, pkl, Whoosh BM25), logs and secrets.

##############################
# OS
##############################
.DS_Store
Thumbs.db
desktop.ini

##############################
# Python
##############################
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
.pytest_cache/
coverage/
coverage.xml
htmlcov/
.mypy_cache/
.tox/

# Byte-compiled / optimized / DLL files
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
CBvenv/
backend/CBvenv/

# Environment variables / secrets
secrets.json
config/*.secret

# FAISS / vector/index files
data/faiss_index.bin
data/index_metadata.pkl
data/documents.pkl

# Whoosh / BM25 index folder
data/bm25_index/
data/bm25_index/*

##############################
# Node / Frontend
##############################
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/build/
frontend/dist/
/.pnp/
/.pnp.js

##############################
# IDEs / Editors
##############################
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

##############################
# Docker
##############################
docker-compose.override.yml
docker-compose.*.yml

##############################
# Logs / temp
##############################
logs/
*.log
npm-debug.log*
yarn-debug.log*
*.log.*
tmp/
temp/
*.tmp

##############################
# Jupyter
##############################
.ipynb_checkpoints
*.ipynb

##############################
# Test / CI
##############################
.pytest_cache/
.coverage
coverage.xml
test-reports/

##############################
# Misc / binaries
##############################
*.exe
*.dll
*.so
*.dylib
*.lib

# SSH/keys
*.pem
*.key

# Mac Thumbs
Icon

# End of file
backend/data/workflow_outputs/*