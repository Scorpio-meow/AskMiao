# =============================================================================
# ChatBot 應用程式環境變數配置範本
# =============================================================================
# 使用說明:
# 1. 複製此檔案為 .env: cp .env.template .env
# 2. 填入實際的密鑰和配置值
# 3. 確保 .env 已加入 .gitignore（絕不提交到版本控制）
# =============================================================================

# -----------------------------------------------------------------------------
# 🔐 安全密鑰 (Security Keys)
# -----------------------------------------------------------------------------
# ⚠️  警告：這些是敏感密鑰，必須設置為強隨機值！
# 🔑 生成新密鑰: python backend/scripts/generate_secure_keys.py

ADMIN_API_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING_64_CHARS
JWT_SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING_64_CHARS
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING_64_CHARS
JWT_ALGORITHM=RS256

# Token 過期時間
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 🌐 環境配置 (Environment Configuration)
# -----------------------------------------------------------------------------
# 環境類型: development | production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# 🤖 LLM Models API Configuration
# -----------------------------------------------------------------------------
# ⚠️  生產環境禁止使用 ngrok！請使用專用域名
MODEL_NAME=gpt-oss:20b
LLM_API_BASE=https://your-llm-api.yourdomain.com
LLM_TIMEOUT=90
MAX_CONTEXT_LENGTH=4000
QUERY_REWRITE_MODEL=phi4-mini:3.8b

# -----------------------------------------------------------------------------
# 💾 數據庫配置 (Database Configuration)
# -----------------------------------------------------------------------------
# 開發環境使用 SQLite
DATABASE_URL=sqlite:///./chatbot.db

# 生產環境使用 PostgreSQL（範例）
# DATABASE_URL=postgresql://user:password@localhost:5432/chatbot_db

# 連接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
SQLALCHEMY_ECHO=false

# -----------------------------------------------------------------------------
# 🌍 CORS 配置 (CORS Configuration)
# -----------------------------------------------------------------------------
# 本地開發環境
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 生產環境（請替換為您的實際域名）
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# 🔒 開發環境 DevTunnel（可選，精確 URL）
# DEVTUNNEL_URL=https://your-specific-subdomain.devtunnels.ms

# ⚠️  ALLOWED_ORIGIN_REGEX 已禁用，請改用上述精確 URL

# -----------------------------------------------------------------------------
# 🧠 RAG 系統配置 (RAG System Configuration)
# -----------------------------------------------------------------------------
# Embedding Models
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Search Parameters
SIMILARITY_THRESHOLD=0.25
TOP_K=50
RERANK_TOP_K=80
FINAL_K=10
RERANK_WEIGHT=0.8
FINAL_THRESHOLD=0.1

# Hybrid Search Configuration
HYBRID_ALPHA=0.7
NORMALIZATION=max

# Text Chunking Configuration
CHUNK_SIZE=300
CHUNK_OVERLAP=100

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss

# Auto Reindexing Configuration
ENABLE_AUTO_REINDEX=0
REINDEX_HOURS=24
ENABLE_AUTO_REINDEX_TASK=1
REINDEX_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# 📁 檔案上傳配置 (File Upload Configuration)
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=data/uploads

# -----------------------------------------------------------------------------
# ⏰ 背景任務配置 (Background Tasks Configuration)
# -----------------------------------------------------------------------------
UPLOADS_WATCHER_INTERVAL=30

# -----------------------------------------------------------------------------
# 🖥️  伺服器配置 (Server Configuration)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
RELOAD=true

# -----------------------------------------------------------------------------
# 🔄 工作流 API 配置 (Workflow API Configuration)
# -----------------------------------------------------------------------------
WORKFLOW_TIMEOUT=180

# -----------------------------------------------------------------------------
# 📊 數據存儲路徑 (Data Storage Paths)
# -----------------------------------------------------------------------------
DATA_DIR=data
FAISS_INDEX_PATH=data/faiss_index.bin
DOCUMENTS_PATH=data/documents.pkl
BM25_INDEX_DIR=data/bm25_index
METADATA_PATH=data/index_metadata.pkl
WORKFLOW_OUTPUTS_DIR=data/workflow_outputs

# -----------------------------------------------------------------------------
# 📝 日誌配置 (Logging Configuration)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 🧪 開發配置 (Development Configuration)
# -----------------------------------------------------------------------------
DEBUG=false

# -----------------------------------------------------------------------------
# 🚦 速率限制配置 (Rate Limiting Configuration)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# -----------------------------------------------------------------------------
# 💨 快取配置 (Cache Configuration)
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_STATS_TTL=180
CACHE_DOCUMENTS_TTL=600
CACHE_MODELS_TTL=900
CACHE_MAX_SIZE=1000

# -----------------------------------------------------------------------------
# ⚙️  並發配置 (Concurrency Configuration)
# -----------------------------------------------------------------------------
UVICORN_WORKERS=4
UVICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
UVICORN_BACKLOG=2048
UVICORN_KEEPALIVE_TIMEOUT=5
