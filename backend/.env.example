# === 核心 LLM 配置 (必填) ===
LLM_API_BASE=http://localhost:5000
LLM_TIMEOUT=120

# === 安全配置 (必填) ===
ADMIN_API_KEY=your_admin_api_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === 環境設定 ===
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
RELOAD=true
LOG_LEVEL=INFO

# === 資料庫配置 ===
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chatbot
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# === Redis 配置 (Token 黑名單) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
ENABLE_REDIS_CACHE=true
CACHE_TTL_SECONDS=300

# === RAG 系統 - 模型配置 ===
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# === Hugging Face / Transformers Cache ===
HF_HOME=./data/hf_home
HUGGINGFACE_HUB_CACHE=./data/hf_home/hub
TRANSFORMERS_CACHE=./data/hf_home/transformers
SENTENCE_TRANSFORMERS_HOME=./data/hf_home/sentence-transformers
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# === RAG 系統 - GPU 配置 ===
FORCE_CPU=true
USE_FP16_QUANTIZATION=false
GPU_BATCH_SIZE=128
CPU_BATCH_SIZE=32
USE_FAISS_GPU=false
FAISS_GPU_DEVICE=0
FAISS_GPU_TEMP_MEMORY=2147483648

# === RAG 系統 - 檢索參數 ===
SIMILARITY_THRESHOLD=0.30
TOP_K=30
RERANK_TOP_K=50
FINAL_K=8
RERANK_WEIGHT=0.85
FINAL_THRESHOLD=0.15
HYBRID_ALPHA=0.75
NORMALIZATION=max

# === RAG 系統 - 文檔處理 ===
CHUNK_SIZE=300
CHUNK_OVERLAP=100
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=data/uploads

# === RAG 系統 - 索引管理 ===
ENABLE_AUTO_REINDEX=0
ENABLE_AUTO_REINDEX_TASK=1
REINDEX_HOURS=24
DATA_DIR=data
FAISS_INDEX_PATH=data/faiss_index.bin
DOCUMENTS_PATH=data/documents.pkl
BM25_INDEX_DIR=data/bm25_index
METADATA_PATH=data/index_metadata.pkl

# === CORS 配置 ===
ALLOWED_ORIGINS=http://localhost:3001,https://localhost:3001
DEVTUNNEL_URL=

# === 速率限制 ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# === 背景任務 ===
UPLOADS_WATCHER_INTERVAL=30
ENABLE_BATCH_ACCUMULATION=false
BATCH_ACCUMULATOR_SIZE=32

# === 健康檢查 ===
BASE_URL=http://localhost:8001
