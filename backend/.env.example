# =============================================================================
# ChatBot 應用程式環境變數配置範本
# =============================================================================
# 注意：請複製此檔案為 .env 並填入實際的值
# 警告：.env 檔案包含敏感資訊，絕對不要提交到 Git！
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Models API Configuration
# -----------------------------------------------------------------------------
MODEL_NAME=your_model_name_here
LLM_API_BASE=https://your-llm-api-endpoint.com
LLM_TIMEOUT=120

# Available models (comma-separated)
AVAILABLE_MODELS=model1,model2,model3

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# 管理員 API Key（使用強隨機字串，至少32字符）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# JWT Authentication Configuration
# JWT Secret Key（使用強隨機字串，至少64字符）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# 開發環境使用 SQLite
DATABASE_URL=sqlite:///./chatbot.db

# 生產環境使用 PostgreSQL（範例）
# DATABASE_URL=postgresql://user:password@localhost:5432/chatbot_db

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# 本地開發環境
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 生產環境（請替換為您的實際域名）
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# -----------------------------------------------------------------------------
# RAG System Configuration
# -----------------------------------------------------------------------------
# Embedding Models
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Search Parameters
SIMILARITY_THRESHOLD=0.25
TOP_K=50
RERANK_TOP_K=80
FINAL_K=10
RERANK_WEIGHT=0.8
FINAL_THRESHOLD=0.1

# Hybrid Search Configuration
HYBRID_ALPHA=0.7
NORMALIZATION=max

# Text Chunking Configuration
CHUNK_SIZE=300
CHUNK_OVERLAP=100

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss

# Auto Reindexing Configuration
ENABLE_AUTO_REINDEX=0
REINDEX_HOURS=24
ENABLE_AUTO_REINDEX_TASK=1
REINDEX_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=data/uploads

# -----------------------------------------------------------------------------
# Background Tasks Configuration
# -----------------------------------------------------------------------------
UPLOADS_WATCHER_INTERVAL=30

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
RELOAD=true

# -----------------------------------------------------------------------------
# Workflow API Configuration
# -----------------------------------------------------------------------------
WORKFLOW_TIMEOUT=180

# -----------------------------------------------------------------------------
# Data Storage Paths
# -----------------------------------------------------------------------------
DATA_DIR=data
FAISS_INDEX_PATH=data/faiss_index.bin
DOCUMENTS_PATH=data/documents.pkl
BM25_INDEX_DIR=data/bm25_index
METADATA_PATH=data/index_metadata.pkl
WORKFLOW_OUTPUTS_DIR=data/workflow_outputs

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Development Configuration
# -----------------------------------------------------------------------------
DEBUG=true

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
