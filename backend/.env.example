# Backend environment example
# Copy to backend/.env and adjust values

# LLM base url (ngrok or internal endpoint)
LLM_BASE_URL=http://localhost:8001
LLM_MODEL=gpt-oss:20b
# If using OpenAI-compatible paths, no need to set below
# LLM_GENERATE_PATH=/v1/chat/completions
# LLM_STREAM_PATH=/v1/chat/completions

# Database / Redis (for later stories)
# DATABASE_URL=postgresql+psycopg2://app:app@postgres:5432/hrchatbot
# REDIS_URL=redis://redis:6379/0
