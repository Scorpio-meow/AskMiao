# AskMiao 後端設定範本（3.0.0）
# 複製為 backend/.env 後依環境調整；每個設定的預設值與作用見 docs/configuration.md
# 標示「必填」的設定沒有預設值，缺少任一項後端就無法啟動
# === LLM 供應商 - Ollama（選填）===
# 本機 Ollama 服務位址：呼叫 Ollama 模型與查詢遠端模型清單時使用
LLM_API_BASE=http://localhost:11434
# LLM 呼叫逾時秒數
LLM_TIMEOUT=120
# Ollama 生成參數（選填，未設定時使用模型預設值）
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_PREDICT=2048
# === 自主研究 Agent 與聯網搜尋配置 (必填) ===
# ENABLE_WEB_SEARCH 同時控制 web_search 與 web_fetch；AGENT_MAX_TURNS 為單次提問的工具調用輪數上限 (>=1)
# CONVERSATION_HISTORY_MESSAGES 為提問時從資料庫帶入的前文訊息數（使用者與助理訊息合計，0 表示不帶前文）
ENABLE_WEB_SEARCH=true
AGENT_MAX_TURNS=5
CONVERSATION_HISTORY_MESSAGES=6
# web_fetch 可讀取的網域（含子網域），逗號分隔，例如 gov.tw,example.com；明確寫 * 才表示不限制網域
# 無論設定為何，web_fetch 都只能讀取使用者訊息或本次工具結果中原樣出現過的網址
WEB_FETCH_ALLOWED_DOMAINS=*
# 同一次提問中知識庫工具回傳過內容後，拒絕 web_search 與 web_fetch（避免內部資料被帶進外部請求）
BLOCK_WEB_TOOLS_AFTER_KB=true
# 選填：Ollama 官方 Web Search / Web Fetch API 金鑰；設定後聯網工具優先使用 Ollama API，失敗時改用 DuckDuckGo 或直接抓取
# OLLAMA_API_KEY=your_ollama_cloud_api_key_here
# === Azure OpenAI v1 配置 (選填；金鑰與端點都設定才啟用，模型名稱為部署名稱時改走 Azure) ===
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# 部署名稱，逗號分隔可列多個，第一個為預設
# AZURE_OPENAI_DEPLOYMENT=gpt-6-sol
# === OpenAI 配置 (選填) ===
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE=https://api.openai.com/v1
# === Anthropic Claude 配置 (選填) ===
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_API_BASE=https://api.anthropic.com
# 使用 Claude 模型時必填：單次回應的輸出 token 上限
# ANTHROPIC_MAX_TOKENS=16000
# === Google Gemini 配置 (選填) ===
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
# === 可用模型清單 (選填；設定後完全取代依金鑰自動產生的清單) ===
# AVAILABLE_MODELS=gpt-6-sol,gpt-6-luna,claude-opus-5-5,claude-sonnet-5,gemini-3.5-flash
# === 安全配置 ===
# 必填：請換成隨機字串，例如 python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_API_KEY 目前沒有路由使用，但設定驗證要求此值；JWT_SECRET_KEY 只在 RSA 金鑰無法載入時用於 HS256 簽署
ADMIN_API_KEY=your_admin_api_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
# 保留設定，目前未被程式採用：RSA 金鑰可用時固定 RS256（金鑰存放於 backend/keys/，首次啟動自動產生），否則開發環境改用 HS256
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# === 環境設定 ===
# production 時重新整理權杖 Cookie 預設加上 Secure，且 RSA 金鑰無法載入時拒絕啟動
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
RELOAD=true
LOG_LEVEL=INFO
# === 資料庫配置 ===
# 必填。零依賴啟動請改為 sqlite:///./chatbot.db（相對路徑依啟動目錄而定）
# 使用 backend/docker-compose.yml 的 PostgreSQL 時，埠號為 7690：postgresql+psycopg2://postgres:postgres@localhost:7690/chatbot
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chatbot
# 連線池設定只套用於 PostgreSQL 等非 SQLite 資料庫
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
# === RAG 系統 - 模型配置 ===
# 嵌入模型更換後維度不同時，舊索引改名為 *.mismatch.bak 並自動重新計算；重排模型為必要元件，載入失敗時後端無法啟動
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# === Hugging Face 模型快取（選填；未設定時使用函式庫預設的 ~/.cache/huggingface）===
# 啟動時會在載入模型前寫入環境變數；HF_HUB_CACHE、SENTENCE_TRANSFORMERS_HOME 預設跟隨 HF_HOME，需分開存放時再設定
HF_HOME=./data/hf_home
# HF_HUB_CACHE=./data/hf_home/hub
# SENTENCE_TRANSFORMERS_HOME=./data/hf_home/sentence-transformers
# 首次啟動需下載模型；模型快取完成後可改為 true，啟動時不再連線檢查更新
HF_HUB_OFFLINE=false
HF_HUB_DISABLE_SYMLINKS_WARNING=true
# === RAG 系統 - GPU 配置 ===
FORCE_CPU=true
USE_FP16_QUANTIZATION=false
GPU_BATCH_SIZE=128
CPU_BATCH_SIZE=32
USE_FAISS_GPU=false
FAISS_GPU_DEVICE=0
FAISS_GPU_TEMP_MEMORY=2147483648
# === RAG 系統 - 檢索參數 ===
# 流程：向量與 BM25 各取 TOP_K 筆 → RRF 融合 → 前 RERANK_TOP_K 筆重排 → 相關性門檻過濾 → 取前 FINAL_K 筆
# SIMILARITY_THRESHOLD 只用於單獨的向量搜尋，RRF 混合檢索的主流程不套用
SIMILARITY_THRESHOLD=0.30
TOP_K=30
# RRF 融合常數：分數 = Σ 1 / (RRF_K + 名次)（必填）
RRF_K=60
# 重排成本與片段長度成正比（CPU 實測約每對 0.2 秒 / 300 字、0.4 秒 / 800 字）
RERANK_TOP_K=20
FINAL_K=8
# 混合分數（只用於排序）= RERANK_WEIGHT × 重排機率 + (1 − RERANK_WEIGHT) × 候選原分數
RERANK_WEIGHT=0.85
# 重排模型機率低於此值的片段視為無關，全部被濾掉時回報「知識庫中查無相關資料」（必填，0~1）
# 精確比對到網址、貼文 ID、日期的片段不受此限制；0.2 為小語料暫定值，請用 scripts/evaluate_retrieval.py --relevance-thresholds 以問答集校準
RERANK_RELEVANCE_THRESHOLD=0.2
# === RAG 系統 - 領域設定與斷詞 ===
# 領域詞、結構化記錄日期欄位與摘要備援規則（必填；相對路徑以 backend/ 為基準）
DOMAIN_PROFILE_PATH=config/domain_profile.json
# 選填：替換 jieba 主詞典，未設定時使用 jieba 內建詞典；變更後 BM25 索引會自動重建
# 繁體較友善的詞典：https://raw.githubusercontent.com/fxsjy/jieba/master/extra_dict/dict.txt.big
# JIEBA_DICTIONARY=data/jieba/dict.txt.big
# === RAG 系統 - 文檔處理 ===
# 修改切塊設定後，需呼叫 POST /api/documents/rebuild-index 才會套用到既有文件
CHUNK_SIZE=300
CHUNK_OVERLAP=100
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=data/uploads
# === RAG 系統 - 索引管理（相對路徑以 backend/ 為基準） ===
DATA_DIR=data
FAISS_INDEX_PATH=data/faiss_index.bin
BM25_INDEX_DIR=data/bm25_index
METADATA_PATH=data/index_metadata.pkl
# === CORS 配置 ===
# 前端直接呼叫後端（frontend/.env 設定了 VITE_API_BASE）時，這裡要包含前端來源；DEVTUNNEL_URL 會額外加入白名單
ALLOWED_ORIGINS=http://localhost:3001,https://localhost:3001
DEVTUNNEL_URL=
# === 速率限制 ===
# 依來源 IP 計算，每 60 秒上限；經由代理連線時所有使用者共用同一個額度
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
# === 背景任務 ===
# 檢查上傳檔是否遺失的間隔秒數（只記警告，不刪除資料）
UPLOADS_WATCHER_INTERVAL=30
# 保留設定，目前沒有程式路徑使用
ENABLE_BATCH_ACCUMULATION=false
BATCH_ACCUMULATOR_SIZE=32
# === 健康檢查 ===
# 只有 healthcheck.py 使用，且它讀取行程環境變數而非本檔
BASE_URL=http://localhost:8001
