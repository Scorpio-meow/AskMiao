# AskMiao 後端設定範本（8.14.0），各設定說明見 docs/configuration.md

# === 伺服器 ===
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8001
RELOAD=false
ENABLE_API_DOCS=false
LOG_LEVEL=INFO
LOG_DIR=logs

# === 資料庫 ===
# POSTGRES_PASSWORD=your_postgres_password_here
# POSTGRES_APP_USER=askmiao_app
# POSTGRES_APP_PASSWORD=your_app_db_password_here
# DATABASE_URL=postgresql+psycopg2://askmiao_app:your_app_db_password_here@localhost:7690/chatbot
DATABASE_URL=postgresql+psycopg2://askmiao_app:your_app_db_password_here@localhost:5432/chatbot
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# === 帳號與安全 ===
TOOL_SECRETS_KEY=your_tool_secrets_key_here
ALLOW_REGISTRATION=false
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_ADDRESS=20
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# === CORS 與速率限制 ===
ALLOWED_ORIGINS=http://localhost:3001,https://localhost:3001
DEVTUNNEL_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
# FORWARDED_ALLOW_IPS=127.0.0.1

# === LLM 呼叫 ===
LLM_TIMEOUT=120
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_PREDICT=2048
# OLLAMA_NUM_CTX=16384

# === Agent 與聯網工具 ===
ENABLE_WEB_SEARCH=true
CONVERSATION_HISTORY_MESSAGES=6
WEB_FETCH_ALLOWED_DOMAINS=*
BLOCK_WEB_TOOLS_AFTER_KB=true
# OLLAMA_API_KEY=your_ollama_cloud_api_key_here
SKILLS_DIR=data/skills

# === RAG 模型與運算裝置 ===
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
FORCE_CPU=true
USE_FP16_QUANTIZATION=false
GPU_BATCH_SIZE=128
CPU_BATCH_SIZE=32
USE_FAISS_GPU=false
FAISS_GPU_DEVICE=0
FAISS_GPU_TEMP_MEMORY=2147483648
# RERANKER_OPENVINO_DEVICE=GPU
# RERANKER_OPENVINO_MAX_LENGTH=256

# === Hugging Face 模型快取 ===
HF_HOME=./data/hf_home
# HF_HUB_CACHE=./data/hf_home/hub
# SENTENCE_TRANSFORMERS_HOME=./data/hf_home/sentence-transformers
HF_HUB_OFFLINE=false
HF_HUB_DISABLE_SYMLINKS_WARNING=true

# === 檢索 ===
SIMILARITY_THRESHOLD=0.30
TOP_K=30
RRF_K=60
RERANK_TOP_K=20
FINAL_K=8
RERANK_WEIGHT=0.85
RERANK_RELEVANCE_THRESHOLD=0.02

# === 領域設定、斷詞與切塊 ===
DOMAIN_PROFILE_PATH=config/domain_profile.json
# JIEBA_DICTIONARY=data/jieba/dict.txt.big
CHUNK_SIZE=300
CHUNK_OVERLAP=100

# === 上傳與索引檔 ===
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=data/uploads
DATA_DIR=data
FAISS_INDEX_PATH=data/faiss_index.bin
BM25_INDEX_DIR=data/bm25_index
METADATA_PATH=data/index_metadata.json
UPLOADS_WATCHER_INTERVAL=30