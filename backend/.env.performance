# ========================================
# 效能優化配置文件
# 複製到 .env 並根據需求調整
# ========================================

# === 資料庫連接池配置 ===
DB_POOL_SIZE=20                    # 連接池大小
DB_MAX_OVERFLOW=40                 # 最大溢出連接數
DB_POOL_RECYCLE=3600               # 連接回收時間（秒）
DB_POOL_PRE_PING=true              # 連接前 ping 檢測
SQLALCHEMY_ECHO=false              # SQL 查詢日誌（開發用）

# === RAG 系統效能調優 ===
# 向量檢索參數
TOP_K=30                           # 初始檢索數量（從 50 降低以提升速度）
RERANK_TOP_K=50                    # 重排序候選數量（從 80 降低）
FINAL_K=8                          # 最終返回文檔數（從 10 降低）
SIMILARITY_THRESHOLD=0.3           # 相似度閾值（從 0.25 提高以減少噪音）

# 混合檢索權重
HYBRID_ALPHA=0.7                   # 向量檢索權重（0.7 = 70% 向量，30% BM25）
RERANK_WEIGHT=0.8                  # 重排序權重
FINAL_THRESHOLD=0.15               # 最終閾值（從 0.1 提高）

# 文檔分塊參數
CHUNK_SIZE=400                     # 分塊大小（從 300 提高以減少總塊數）
CHUNK_OVERLAP=120                  # 重疊大小（從 100 提高以保持上下文）

# 索引重建
REINDEX_HOURS=48                   # 自動重建間隔（小時）從 24 延長到 48

# LLM 配置
LLM_TIMEOUT=90                     # LLM API 超時（秒）從 120 降低
MAX_CONTEXT_LENGTH=4000            # 最大上下文長度

# === API 快取配置 ===
CACHE_ENABLED=true                 # 啟用快取
CACHE_DEFAULT_TTL=300              # 預設快取時間（秒）
CACHE_STATS_TTL=180                # 統計資料快取時間（秒）
CACHE_DOCUMENTS_TTL=600            # 文檔列表快取時間（秒）

# === 前端效能配置 ===
# 這些會被前端的 .env 使用
REACT_APP_API_TIMEOUT=30000        # API 超時（毫秒）
REACT_APP_ENABLE_CACHE=true        # 啟用前端快取
REACT_APP_CACHE_TTL=180000         # 前端快取 TTL（毫秒）

# === 日誌配置 ===
LOG_LEVEL=INFO                     # 日誌級別（DEBUG/INFO/WARNING/ERROR）
LOG_SQL_QUERIES=false              # 記錄 SQL 查詢（效能影響大）

# === 並發配置 ===
UVICORN_WORKERS=4                  # Uvicorn worker 數量
UVICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker

# === 限流配置 ===
RATE_LIMIT_ENABLED=true            # 啟用限流
RATE_LIMIT_PER_MINUTE=100          # 每分鐘請求限制（從 60 提高）
