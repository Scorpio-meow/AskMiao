# =============================================================================
# ChatBot 效能優化配置範本
# =============================================================================
# 用途：針對不同規模伺服器的優化配置建議
# 使用方式：複製對應的配置段落到 .env 文件中
# 更新日期：2025-10-13
# =============================================================================

# =============================================================================
# 小型伺服器配置 (2核4GB)
# =============================================================================
# 適用場景：開發環境、小型團隊（< 20 用戶）
# 預期效能：50-100 req/s

[SMALL_SERVER]
# 資料庫
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_POOL_USE_LIFO=true

# 並發
UVICORN_WORKERS=2
UVICORN_BACKLOG=512

# RAG 系統
TOP_K=20
RERANK_TOP_K=30
FINAL_K=5
CHUNK_SIZE=400
CHUNK_OVERLAP=120

# 快取
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_MAX_SIZE=500

# LLM
LLM_TIMEOUT=90
MAX_CONTEXT_LENGTH=3000

# =============================================================================
# 中型伺服器配置 (4核8GB) - **推薦用於生產環境**
# =============================================================================
# 適用場景：中小企業、部門應用（20-100 用戶）
# 預期效能：200-400 req/s

[MEDIUM_SERVER]
# 資料庫
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_POOL_USE_LIFO=true

# 並發
UVICORN_WORKERS=4
UVICORN_BACKLOG=2048
UVICORN_KEEPALIVE_TIMEOUT=5

# RAG 系統
TOP_K=30
RERANK_TOP_K=50
FINAL_K=8
SIMILARITY_THRESHOLD=0.3
HYBRID_ALPHA=0.7
CHUNK_SIZE=400
CHUNK_OVERLAP=120

# 快取
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_STATS_TTL=180
CACHE_DOCUMENTS_TTL=600
CACHE_MODELS_TTL=900
CACHE_MAX_SIZE=1000

# LLM
LLM_TIMEOUT=90
MAX_CONTEXT_LENGTH=4000

# 限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_BURST=20

# =============================================================================
# 大型伺服器配置 (8核16GB+)
# =============================================================================
# 適用場景：企業級應用（100+ 用戶）
# 預期效能：500-1000+ req/s

[LARGE_SERVER]
# 資料庫
DB_POOL_SIZE=40
DB_MAX_OVERFLOW=80
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_POOL_USE_LIFO=true

# 並發
UVICORN_WORKERS=8
UVICORN_BACKLOG=4096
UVICORN_KEEPALIVE_TIMEOUT=10

# RAG 系統
TOP_K=50
RERANK_TOP_K=80
FINAL_K=10
SIMILARITY_THRESHOLD=0.3
HYBRID_ALPHA=0.7
CHUNK_SIZE=400
CHUNK_OVERLAP=120

# 快取
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=600
CACHE_STATS_TTL=300
CACHE_DOCUMENTS_TTL=1200
CACHE_MODELS_TTL=1800
CACHE_MAX_SIZE=2000

# LLM
LLM_TIMEOUT=120
MAX_CONTEXT_LENGTH=6000

# 限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=200
RATE_LIMIT_PER_HOUR=5000
RATE_LIMIT_BURST=50

# =============================================================================
# 開發環境配置
# =============================================================================
# 適用場景：本地開發、測試
# 特點：詳細日誌、快速重載、寬鬆限制

[DEVELOPMENT]
# 資料庫
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
SQLALCHEMY_ECHO=true  # 啟用 SQL 日誌

# 並發
UVICORN_WORKERS=1
RELOAD=true

# RAG 系統（較寬鬆以便測試）
TOP_K=50
FINAL_K=10
SIMILARITY_THRESHOLD=0.2

# 快取（較短 TTL 便於測試）
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=60
CACHE_MAX_SIZE=100

# 日誌
LOG_LEVEL=DEBUG
DEBUG=true

# 限流（寬鬆設定）
RATE_LIMIT_ENABLED=false

# =============================================================================
# 效能調優指南
# =============================================================================

## 資料庫連接池調整原則
# - 基本公式：pool_size = 核心數 * 2 到 * 4
# - max_overflow = pool_size * 2
# - 監控指標：連接等待時間、池使用率
# - 過大會浪費資源，過小會導致等待

## RAG 參數權衡
# - TOP_K ↑ = 召回率↑ + 速度↓
# - FINAL_K ↑ = 上下文更豐富 + LLM 延遲↑
# - SIMILARITY_THRESHOLD ↑ = 精確度↑ + 召回率↓
# - CHUNK_SIZE ↑ = 總塊數↓ + 檢索粒度↓

## 快取策略建議
# - 靜態資料（模型列表）：TTL 15-30分鐘
# - 動態資料（統計）：TTL 3-5分鐘
# - 用戶資料：不快取或極短 TTL
# - 監控快取命中率，目標 > 60%

## 並發調整
# - UVICORN_WORKERS 不宜超過 CPU 核心數 * 2
# - 每個 Worker 消耗 ~100-200MB 記憶體
# - 考慮 BACKLOG 避免連接拒絕

## 限流設定
# - 根據實際業務需求調整
# - 考慮突發流量設定 BURST
# - 監控觸發頻率調整閾值

# =============================================================================
# 監控指標參考
# =============================================================================

## 關鍵效能指標 (KPI)
# - API 響應時間 P95 < 500ms, P99 < 1000ms
# - 資料庫連接池使用率 < 80%
# - 快取命中率 > 60%
# - 錯誤率 < 1%
# - CPU 使用率 < 70%
# - 記憶體使用率 < 80%

## 告警閾值建議
# - 響應時間 P95 > 1000ms
# - 資料庫連接池使用率 > 90%
# - 快取命中率 < 40%
# - 錯誤率 > 5%
# - CPU 使用率 > 85%
# - 記憶體使用率 > 90%

# =============================================================================
# 使用說明
# =============================================================================

## 步驟 1：選擇配置
# 根據伺服器規格選擇對應的配置段落（SMALL/MEDIUM/LARGE/DEVELOPMENT）

## 步驟 2：複製到 .env
# 將選中的配置段落複製到 backend/.env 文件中

## 步驟 3：調整敏感資訊
# 更新 JWT_SECRET_KEY, ADMIN_API_KEY 等敏感配置

## 步驟 4：重啟服務
# 重啟後端服務以套用新配置

## 步驟 5：監控與調優
# 使用 performance_test.py 測試效能
# 根據實際負載調整參數

# =============================================================================
# 故障排查
# =============================================================================

## 問題：資料庫連接錯誤
# 檢查：DB_POOL_SIZE 是否過大
# 解決：降低 pool_size 和 max_overflow

## 問題：API 響應緩慢
# 檢查：TOP_K 和 RERANK_TOP_K 是否過大
# 解決：降低檢索參數，提升快取 TTL

## 問題：記憶體不足
# 檢查：UVICORN_WORKERS 和 CACHE_MAX_SIZE
# 解決：減少 worker 數量或快取大小

## 問題：快取未生效
# 檢查：CACHE_ENABLED 是否為 true
# 解決：確認快取配置並檢查日誌

