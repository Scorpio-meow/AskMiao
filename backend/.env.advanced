# ============================================
# 進階優化配置 (FAISS-GPU + FP16 + 批次累積)
# ============================================

# === FAISS-GPU 配置 ===
USE_FAISS_GPU=false          # 啟用後需安裝 faiss-gpu (conda install faiss-gpu)
FAISS_GPU_DEVICE=0           # GPU 設備 ID
FAISS_GPU_TEMP_MEMORY=2147483648  # GPU 臨時記憶體 (2GB)

# === 模型量化 (FP16) ===
USE_FP16_QUANTIZATION=true   # 啟用 FP16 量化 (減少 50% 顯存)
# 優點: 顯存減少 50%, 速度提升 20-30%
# 缺點: 精度損失 < 1% (對大多數任務可忽略)

# === 批次累積 ===
ENABLE_BATCH_ACCUMULATION=true  # 啟用批次累積
BATCH_ACCUMULATOR_SIZE=32        # 批次大小
BATCH_MAX_WAIT_MS=50             # 最大等待時間 (毫秒)
BATCH_MIN_SIZE=4                 # 最小批次大小

# === GPU 優化配置 ===
GPU_BATCH_SIZE=128          # FP16 模式可提升到 256
CUDA_VISIBLE_DEVICES=0      # 使用第一張 GPU

# === 基礎配置 ===
MODEL_NAME=gpt-oss:20b
LLM_API_BASE=http://localhost:11434
LLM_TIMEOUT=120

# === RAG 系統 ===
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SIMILARITY_THRESHOLD=0.25
TOP_K=50
RERANK_TOP_K=80
FINAL_K=10

# === Redis 快取 ===
ENABLE_REDIS_CACHE=true
CACHE_TTL_SECONDS=300

# === 性能監控 ===
ENABLE_PERFORMANCE_LOGGING=true
SLOW_QUERY_THRESHOLD=2.0

# ============================================
# 性能預期 (啟用所有優化)
# ============================================
# FAISS-GPU:     查詢延遲 -85% (15ms → 2ms)
# FP16 量化:      顯存使用 -50%, 速度 +25%
# 批次累積:       GPU 利用率 +20-30%
# 整體提升:       吞吐量 +50-100%
# ============================================
