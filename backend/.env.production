# ============================================
# ChatBot 生產環境配置 (RTX 4090 + i9-13900KF)
# ============================================

# GPU 優化配置
GPU_BATCH_SIZE=128          # RTX 4090 24GB 最佳批次大小
CPU_BATCH_SIZE=32           # CPU 備用批次大小
CUDA_VISIBLE_DEVICES=0      # 使用第一張 GPU

# Redis 快取配置
ENABLE_REDIS_CACHE=true     # 啟用 Redis 快取
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=            # 生產環境建議設定密碼
CACHE_TTL_SECONDS=300      # 快取過期時間 5 分鐘

# RAG 系統配置
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SIMILARITY_THRESHOLD=0.25
TOP_K=50
RERANK_TOP_K=80
FINAL_K=10
RERANK_WEIGHT=0.8
FINAL_THRESHOLD=0.1
HYBRID_ALPHA=0.7
NORMALIZATION=max
CHUNK_SIZE=300
CHUNK_OVERLAP=100
REINDEX_HOURS=24
ENABLE_AUTO_REINDEX=0      # 生產環境建議手動重建索引

# LLM API 配置
MODEL_NAME=gpt-oss:20b     # 默認模型
LLM_API_BASE=http://localhost:11434  # Ollama 本地端點
LLM_TIMEOUT=120            # API 超時時間 (秒)

# 數據儲存配置
DATA_DIR=data
FAISS_INDEX_PATH=data/faiss_index.bin
DOCUMENTS_PATH=data/documents.pkl
BM25_INDEX_DIR=data/bm25_index
METADATA_PATH=data/index_metadata.pkl

# 伺服器配置
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8001
UVICORN_WORKERS=32         # 建議: 24 (保守) | 32 (推薦) | 49 (最大)
UVICORN_LOG_LEVEL=info

# 安全配置 (生產環境必須修改)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 配置
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8001

# 資料庫配置
DATABASE_URL=sqlite:///./chatbot.db  # 生產環境建議使用 PostgreSQL

# 日誌配置
LOG_LEVEL=INFO
LOG_FILE=logs/chatbot.log

# 文件上傳限制
MAX_UPLOAD_SIZE=52428800   # 50MB
ALLOWED_EXTENSIONS=txt,pdf,docx

# 性能監控
ENABLE_PERFORMANCE_LOGGING=true
SLOW_QUERY_THRESHOLD=2.0   # 記錄超過 2 秒的查詢
