"""
逐字稿工具 - 音訊轉文字工具
支援多種音訊格式,並提供時間戳記功能
使用 OpenAI Whisper 進行高準確度語音辨識
"""
import os
import json
import gc
import warnings
from datetime import timedelta
from typing import List, Dict, Optional
import whisper
import torch
from pydub import AudioSegment
# 抑制 Whisper 的 Triton 警告
warnings.filterwarnings("ignore", message="Failed to launch Triton kernels")
warnings.filterwarnings("ignore", category=UserWarning, module="whisper")
class Transcriber:
    """逐字稿轉換器 (使用 OpenAI Whisper + CUDA 加速)"""
    
    def __init__(self, language: str = None, model_size: str = "large-v3", use_cuda: bool = None):
        """
        初始化逐字稿工具
        
        Args:
            language: 語言代碼 (zh=中文, en=英文, ja=日文等，None=自動檢測)
            model_size: 模型大小 (tiny, base, small, medium, large, large-v2, large-v3)
                       - tiny: 最快但準確度較低
                       - base: 平衡速度與準確度
                       - small: 更準確但較慢
                       - medium: 高準確度
                       - large: 最高準確度 (V1)
                       - large-v2: 改進版 Large 模型
                       - large-v3: 最新最強大的模型 (預設推薦)
            use_cuda: 是否使用 CUDA 加速 (None=自動檢測, True=強制啟用, False=強制停用)
        """
        self.language = language
        self.transcription = []
        
        # CUDA 設定
        self.device = self._setup_device(use_cuda)
        self._print_device_info()
        
        print(f"正在載入 Whisper {model_size} 模型到 {self.device}...")
        self.model = whisper.load_model(model_size, device=self.device)
        print("模型載入完成!")
        
        # 如果使用 CUDA，進行記憶體優化
        if self.device.startswith('cuda'):
            self._optimize_cuda_memory()
        
        # 如果使用 CUDA，進行記憶體優化
        if self.device.startswith('cuda'):
            self._optimize_cuda_memory()
    
    def _setup_device(self, use_cuda: bool = None) -> str:
        """設定運算設備 (CUDA 或 CPU)"""
        if use_cuda is False:
            return "cpu"
        
        if torch.cuda.is_available():
            if use_cuda is True or use_cuda is None:
                # 選擇第一個可用的 GPU
                return "cuda:0"
        elif use_cuda is True:
            print("警告: 要求使用 CUDA 但系統不支援，將使用 CPU")
        
        return "cpu"
    
    def _print_device_info(self):
        """顯示設備資訊"""
        if self.device == "cpu":
            print("運算設備: CPU")
        else:
            gpu_name = torch.cuda.get_device_name(0)
            gpu_memory = torch.cuda.get_device_properties(0).total_memory / 1024**3
            print(f"運算設備: {gpu_name} (CUDA)")
            print(f"GPU 記憶體: {gpu_memory:.1f} GB")
    
    def _optimize_cuda_memory(self):
        """優化 CUDA 記憶體使用"""
        if torch.cuda.is_available():
            # 清理未使用的記憶體
            torch.cuda.empty_cache()
            # 啟用記憶體分段
            torch.cuda.memory.set_per_process_memory_fraction(0.8)
    
    def _cleanup_cuda_memory(self):
        """清理 CUDA 記憶體"""
        if torch.cuda.is_available():
            torch.cuda.empty_cache()
            gc.collect()
    
    def convert_audio_format(self, input_file: str, output_file: str = None) -> str:
        """
        轉換音訊格式為 WAV (Whisper 偏好格式)
        
        Args:
            input_file: 輸入音訊檔案路徑
            output_file: 輸出 WAV 檔案路徑
        
        Returns:
            轉換後的 WAV 檔案路徑
        """
        if output_file is None:
            base_name = os.path.splitext(input_file)[0]
            output_file = f"{base_name}_converted.wav"
        # 載入音訊檔案
        audio = AudioSegment.from_file(input_file)
        # 轉換為單聲道、16000Hz 的 WAV 格式
        audio = audio.set_channels(1).set_frame_rate(16000)
        audio.export(output_file, format="wav")
        print(f"已轉換音訊格式: {output_file}")
        return output_file
    
    def transcribe_audio(self, audio_file: str, with_timestamps: bool = True) -> List[Dict]:
        """
        使用 Whisper 轉換音訊為逐字稿
        
        Args:
            audio_file: 音訊檔案路徑
            with_timestamps: 是否包含詳細時間戳記 (word-level)
        
        Returns:
            包含時間戳記和文字的逐字稿列表
        """
        print(f"\n開始辨識音訊檔案: {audio_file}")
        print("處理中,請稍候...\n")
        
        # Whisper 可以直接處理多種格式,不需要預先轉換
        # 但如果需要,可以轉換為 WAV
        # audio_file = self.convert_audio_format(audio_file)
        
        # 使用 Whisper 進行轉錄 (支援 CUDA 加速)
        # verbose=True 會顯示處理進度
        try:
            result = self.model.transcribe(
                audio_file,
                language=self.language,  # None 表示自動檢測
                verbose=True,
                word_timestamps=with_timestamps
            )
        except torch.cuda.OutOfMemoryError:
            print("CUDA 記憶體不足，正在清理記憶體後重試...")
            self._cleanup_cuda_memory()
            result = self.model.transcribe(
                audio_file,
                language=self.language,  # None 表示自動檢測
                verbose=True,
                word_timestamps=with_timestamps
            )
        
        self.transcription = []
        
        # 處理結果 - 使用 segment 層級的時間戳記
        if 'segments' in result:
            for segment in result['segments']:
                self.transcription.append({
                    "start": segment['start'],
                    "end": segment['end'],
                    "text": segment['text'].strip()
                })
                print(f"[{self.format_timestamp(segment['start'])} --> {self.format_timestamp(segment['end'])}]")
                print(f"  {segment['text'].strip()}\n")
        else:
            # 如果沒有 segments,使用完整文字
            self.transcription.append({
                "start": 0.0,
                "end": 0.0,
                "text": result['text'].strip()
            })
        
        print("\n轉換完成!")
        print(f"辨識到的語言: {result.get('language', 'unknown')}")
        
        # 清理 GPU 記憶體
        if self.device.startswith('cuda'):
            self._cleanup_cuda_memory()
        
        return self.transcription
    
    def format_timestamp(self, seconds: float, format_type: str = "srt") -> str:
        """
        格式化時間戳記
        
        Args:
            seconds: 秒數
            format_type: 格式類型 (srt 或 vtt)
        
        Returns:
            格式化的時間戳記字串
        """
        td = timedelta(seconds=seconds)
        hours = int(td.total_seconds() // 3600)
        minutes = int((td.total_seconds() % 3600) // 60)
        secs = int(td.total_seconds() % 60)
        millis = int((td.total_seconds() % 1) * 1000)
        
        if format_type == "srt":
            return f"{hours:02d}:{minutes:02d}:{secs:02d},{millis:03d}"
        elif format_type == "vtt":
            return f"{hours:02d}:{minutes:02d}:{secs:02d}.{millis:03d}"
        else:
            return f"{hours:02d}:{minutes:02d}:{secs:02d}"
    
    def export_txt(self, output_file: str):
        """匯出為純文字檔案"""
        with open(output_file, 'w', encoding='utf-8') as f:
            for item in self.transcription:
                f.write(f"{item['text']}\n")
        print(f"已匯出 TXT: {output_file}")
    
    def export_srt(self, output_file: str):
        """匯出為 SRT 字幕檔案"""
        with open(output_file, 'w', encoding='utf-8') as f:
            for i, item in enumerate(self.transcription, 1):
                f.write(f"{i}\n")
                f.write(f"{self.format_timestamp(item['start'], 'srt')} --> ")
                f.write(f"{self.format_timestamp(item['end'], 'srt')}\n")
                f.write(f"{item['text']}\n\n")
        print(f"已匯出 SRT: {output_file}")
    
    def export_vtt(self, output_file: str):
        """匯出為 VTT 字幕檔案"""
        with open(output_file, 'w', encoding='utf-8') as f:
            f.write("WEBVTT\n\n")
            for item in self.transcription:
                f.write(f"{self.format_timestamp(item['start'], 'vtt')} --> ")
                f.write(f"{self.format_timestamp(item['end'], 'vtt')}\n")
                f.write(f"{item['text']}\n\n")
        print(f"已匯出 VTT: {output_file}")
    
    def export_json(self, output_file: str):
        """匯出為 JSON 檔案"""
        with open(output_file, 'w', encoding='utf-8') as f:
            json.dump(self.transcription, f, ensure_ascii=False, indent=2)
        print(f"已匯出 JSON: {output_file}")
    
    def export_all(self, base_filename: str):
        """匯出所有格式"""
        self.export_txt(f"{base_filename}.txt")
        self.export_srt(f"{base_filename}.srt")
        self.export_vtt(f"{base_filename}.vtt")
        self.export_json(f"{base_filename}.json")
def main():
    """主程式"""
    print("=" * 50)
    print("逐字稿工具 v2.1 (Powered by OpenAI Whisper + CUDA)")
    print("=" * 50)
    
    # 使用範例
    audio_file = input("請輸入音訊檔案路徑: ").strip()
    
    if not os.path.exists(audio_file):
        print(f"錯誤: 找不到檔案 '{audio_file}'")
        return
    
    # 語言選擇
    print("\n支援的語言: zh(中文), en(英文), ja(日文), ko(韓文) 等")
    print("留空將自動偵測語言 (推薦)")
    language = input("請輸入語言代碼 (預設自動檢測): ").strip() or None
    
    # 模型選擇
    print("\n模型大小:")
    print("  tiny   - 最快,準確度較低 (~1GB RAM)")
    print("  base   - 平衡速度與準確度 (~1GB RAM)")
    print("  small  - 更準確但較慢 (~2GB RAM)")
    print("  medium - 高準確度 (~5GB RAM)")
    print("  large  - 最高準確度但最慢 (~10GB RAM)")
    print("  large-v3 - 最新最強大的模型 (~10GB RAM) [預設推薦]")
    model_size = input("請選擇模型 (預設 large-v3): ").strip() or "large-v3"
    
    # CUDA 設定
    print("\nCUDA 加速設定:")
    if torch.cuda.is_available():
        gpu_name = torch.cuda.get_device_name(0)
        print(f"  檢測到 GPU: {gpu_name}")
        print("  1. 自動 (推薦) - 自動使用 GPU 加速")
        print("  2. 啟用 - 強制使用 GPU 加速")
        print("  3. 停用 - 僅使用 CPU")
        cuda_choice = input("請選擇 CUDA 設定 (預設 1): ").strip() or "1"
        
        if cuda_choice == "2":
            use_cuda = True
        elif cuda_choice == "3":
            use_cuda = False
        else:  # 預設或 "1"
            use_cuda = None
    else:
        print("  未檢測到 CUDA 支援，將使用 CPU")
        use_cuda = False
    
    # 建立逐字稿工具
    transcriber = Transcriber(language=language, model_size=model_size, use_cuda=use_cuda)
    
    # 轉換音訊
    transcriber.transcribe_audio(audio_file)
    
    # 匯出結果
    base_name = os.path.splitext(audio_file)[0]
    transcriber.export_all(base_name)
    
    print("\n處理完成!")
    print(f"檔案已儲存至: {base_name}.*")
if __name__ == "__main__":
    main()' candidates=0
