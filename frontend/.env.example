# 前端環境變數示例 (.env)
# 複製為 .env 以生效 (需重新啟動前端開發伺服器)

# =============================================================================
# API 連接配置
# =============================================================================

# 後端 API 基礎位址 (支援 tunnel URLs)
# 本地開發:
# REACT_APP_API_BASE=http://127.0.0.1:8001/api
# 使用 tunnel:
REACT_APP_API_BASE=https://1848b1fg-8001.asse.devtunnels.ms/api

# =============================================================================
# 外部模型列表配置 (可選)
# =============================================================================

# 直接使用外部 Ollama 模型列表，不經後端代理
# 若設定此值，會直接 fetch 該 URL，支援格式：陣列 / {models:[]} / {tags:[]} / {data:[]} / {items:[]}
# 留空則透過後端 /api/tags 代理
REACT_APP_TAGS_URL=https://blowfish-absolute-absolutely.ngrok-free.app/api/tags

# (可選) 當 primary 端點失敗時嘗試的後備路徑
REACT_APP_TAGS_FALLBACK_PATH=/v1/models

# (可選) 是否強制加上 ngrok-skip-browser-warning header (可能導致 CORS 問題)
REACT_APP_NGROK_HEADER=false

# =============================================================================
# UI 行為配置
# =============================================================================

# 模型列表輪詢頻率（毫秒）
REACT_APP_TAGS_POLL_INTERVAL=15000