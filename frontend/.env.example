# =============================================================================
# 前端環境變數配置範本
# =============================================================================
# 注意：請複製此檔案為 .env 並填入實際的值
# 警告：前端的 .env 可能會被打包進靜態資源，不要放置敏感資訊！
# =============================================================================

# API 配置 - 使用本地開發環境
# 注意：在生產環境中，請設定正確的後端 API 地址
# REACT_APP_API_BASE=/api  # 使用相對路徑，由 proxy 處理

# Webpack dev server 配置 - 本地開發
PORT=3000

# 開發環境專用（生產環境請移除此設定）
DANGEROUSLY_DISABLE_HOST_CHECK=false
