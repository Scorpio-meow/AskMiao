# === API 連接 (必填) ===
VITE_API_URL=http://localhost:8001
VITE_API_BASE=http://localhost:8001

# === WebSocket 連接 ===
VITE_WS_URL=ws://localhost:8001/api/workflow/ws

# === 外部服務 (可選) ===
VITE_TAGS_URL=

# === 模型輪詢間隔 (毫秒，可選) ===
VITE_MODEL_POLL_INTERVAL_MS=300000

# === 開發服務器配置 ===
PORT=3001

# === 建構優化 ===
GENERATE_SOURCEMAP=true

# 資料庫配置
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chatbot
POSTGRES_IMAGE=postgres:17.9